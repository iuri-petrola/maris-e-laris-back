generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Produto {
  id        Int      @id @default(autoincrement())
  nome      String
  imagemUrl String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("produtos")
}
