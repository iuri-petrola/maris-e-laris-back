generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Produto {
  id        Int        @id @default(autoincrement())
  nome      String
  preco     Decimal    @default(0) @db.Decimal(10, 2)
  imagemUrl String
  videoUrl  String?
  ativo     Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  cartItems CartItem[]

  @@map("produtos")
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}


model ClientUser {
  id           Int        @id @default(autoincrement())
  nome         String     @unique
  email        String     @unique
  whatsapp     String
  passwordHash String
  ativo        Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  cartItems    CartItem[]

  @@map("client_users")
}

model CartItem {
  id           Int        @id @default(autoincrement())
  quantidade   Int        @default(1)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  clientUserId Int
  produtoId    Int
  clientUser   ClientUser @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  produto      Produto    @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@unique([clientUserId, produtoId])
  @@map("cart_items")
}
